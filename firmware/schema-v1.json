{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://updates.onemira.com/firmware/schema-v1.json",
  "title": "OneMira BH1098 firmware feed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "chip",
    "version",
    "published_at",
    "hardware_revisions",
    "ble",
    "usb"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "product": { "const": "mira-context" },
    "chip": { "const": "BH1098" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "published_at": { "type": "string", "format": "date-time" },
    "minimum_current_version": { "type": ["string", "null"] },
    "hardware_revisions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "release_notes": { "type": "string" },
    "ble": { "$ref": "#/$defs/bleArtifact" },
    "usb": { "$ref": "#/$defs/usbArtifact" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["url", "sha256", "size"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 }
      }
    },
    "bleArtifact": {
      "allOf": [
        { "$ref": "#/$defs/artifact" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "sha256", "size", "partition_name"],
          "properties": {
            "url": { "type": "string", "format": "uri", "pattern": "^https://" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "size": { "type": "integer", "minimum": 33 },
            "partition_name": { "type": "string", "minLength": 1, "maxLength": 15 }
          }
        }
      ]
    },
    "usbArtifact": {
      "allOf": [
        { "$ref": "#/$defs/artifact" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "sha256", "size", "format", "opcode", "handoff", "partition_strategy"],
          "properties": {
            "url": { "type": "string", "format": "uri", "pattern": "^https://" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "size": { "type": "integer", "minimum": 1 },
            "format": { "const": "bh1098-partition-zip" },
            "opcode": { "const": "userboot" },
            "handoff": { "const": "application-mbc1-0x33" },
            "partition_strategy": { "const": "inactive-application-slot" }
          }
        }
      ]
    }
  }
}
